# Copia este archivo a ".env" (en esta misma carpeta) para desarrollo local con
# "netlify dev". En producción, estas mismas variables se configuran en
# Netlify: Site settings > Environment variables.

# --- Fase 1: Supabase ---
# URL y clave publicable: van al frontend, se ven en el navegador (normal en
# Supabase, están protegidas por RLS + login). Site settings > Environment
# variables en Netlify, o aquí para "netlify dev".
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para las Netlify Functions (backend). NUNCA con el prefijo VITE_,
# porque eso la enviaría al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase 2: Google Drive (aún no se usa) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Fase 4: Gemini (aún no se usa) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Fase 5: Groq (aún no se usa) ---
# GROQ_API_KEY=

# --- Fase 8: Notificaciones push (aún no se usa) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
